#!/bin/sh
# The development launcher: it resolves the repo it sits in, so it needs a source
# checkout and a completed `npm run build`. Symlink it onto your PATH by hand:
#
#   ln -s "$PWD/bin/breakpoint" /usr/local/bin/breakpoint
#
# The packaged launcher is the same idea against an installed app, and the README
# carries it. Both run the CLI entry under the app's own Electron runtime in Node
# mode, so neither needs a separate Node installation. Phase 5's "Install command
# line tool" replaces both with a menu item.
set -e

# Resolve through any symlinks, so the shim still finds the repo when it is on PATH.
target=$0
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case "$link" in
    /*) target=$link ;;
    *) target=$(dirname "$target")/$link ;;
  esac
done
repo=$(cd "$(dirname "$target")/.." && pwd -P)

cli="$repo/out/main/cli.js"
if [ ! -f "$cli" ]; then
  echo "breakpoint: $cli is missing — run 'npm run build' in $repo first" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin) electron="$repo/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" ;;
  *) electron="$repo/node_modules/electron/dist/electron" ;;
esac

if [ ! -x "$electron" ]; then
  echo "breakpoint: no Electron runtime at $electron — run 'npm install' in $repo first" >&2
  exit 1
fi

ELECTRON_RUN_AS_NODE=1 exec "$electron" "$cli" "$@"
